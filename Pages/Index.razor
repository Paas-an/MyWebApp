@page "/"

<PageTitle>Jonas Skogtrø Olsen</PageTitle>
<HeadContent>
    <meta name="description"
          content="Jonas Skogtrø Olsen – serviceingeniør hos Moltech. Arbeider med maritim elektronikk, navigasjon, kommunikasjon og systemintegrasjon." />
    <link rel="canonical" href="https://www.olsenjonas.no/" />
    <meta property="og:title" content="Jonas Skogtrø Olsen" />
