@page "/"
@using System.Globalization

<PageTitle>Jonas Skogtrø Olsen</PageTitle>

<section class="hero" aria-labelledby="hero-title">
    <p class="hero-eyebrow">Utvikler · Norge</p>
    <h1 id="hero-title">Hei, jeg er Jonas.</h1>
    <p class="hero-lead">
        Jeg bygger og utforsker løsninger med .NET, Blazor og moderne
        webteknologi.
    </p>
    <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/contact">Ta kontakt</a>
        <a class="btn btn-outline-secondary btn-lg"
           href="https://github.com/Paas-an"
           target="_blank"
           rel="noopener noreferrer">Se GitHub-profil</a>
    </div>
</section>

<section class="home-status" aria-labelledby="status-title">
    <h2 id="status-title">Nettsiden er under utvikling</h2>
    <p>
        Porteføljen bygges ut trinnvis. I mellomtiden finner du kontaktinformasjon,
        GitHub, LinkedIn og CV på kontaktsiden.
    </p>
    <p class="text-secondary mb-0">Sist besøkt: @GetTodaysDate()</p>
</section>

@code {
    private static string GetTodaysDate()
    {
        return DateTime.Now.ToString("d. MMMM yyyy", CultureInfo.GetCultureInfo("nb-NO"));
    }
}
