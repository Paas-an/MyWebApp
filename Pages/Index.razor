@page "/"

<PageTitle>Jonas Skogtrø Olsen</PageTitle>
<HeadContent>
    <meta name="description"
          content="Jonas Skogtrø Olsen. Serviceingeniør hos Moltech. Utdanning, arbeidserfaring og kontaktinformasjon." />
    <link rel="canonical" href="https://www.olsenjonas.no/" />
    <meta property="og:title" content="Jonas Skogtrø Olsen" />
    <meta property="og:description"
          content="Jonas Skogtrø Olsen. Serviceingeniør hos Moltech. Utdanning, arbeidserfaring og kontaktinformasjon." />
    <meta property="og:url" content="https://www.olsenjonas.no/" />
    <meta name="twitter:title" content="Jonas Skogtrø Olsen" />
    <meta name="twitter:description"
          content="Jonas Skogtrø Olsen. Serviceingeniør hos Moltech. Utdanning, arbeidserfaring og kontaktinformasjon." />
</HeadContent>

<section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Jonas Skogtrø Olsen</h1>
    <p class="hero-lead">
        Serviceingeniør hos Moltech.
    </p>
    <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/contact">Kontakt</a>
        <a class="btn btn-outline-secondary btn-lg"
           href="https://github.com/Paas-an"
           target="_blank"
           rel="noopener noreferrer">GitHub</a>
    </div>
</section>

<section class="home-status mb-4" aria-labelledby="about-title">
    <h2 id="about-title">Utdanning</h2>
    <p class="mb-0">
        Fagbrev som dataelektroniker. Studier ved NTNU i Trondheim,
        med bacheloroppgave i systemutvikling.
    </p>
</section>

<section class="home-status mb-4" aria-labelledby="work-title">
    <h2 id="work-title">Arbeid</h2>
    <p>
        Service, installasjon og feilsøking på navigasjons- og kommunikasjonsutstyr om bord.
    </p>
    <p class="mb-0">
        Utvikling og oppsett av MolBridge: brukergrensesnitt, nettverk og tilkobling
        av skjermer, signalkilder og instrumenter.
    </p>
</section>

<section class="home-status" aria-labelledby="projects-title">
    <h2 id="projects-title">Fritidsprosjekter</h2>
    <p class="mb-0">
        Webapplikasjoner med maritime data.
    </p>
</section>
