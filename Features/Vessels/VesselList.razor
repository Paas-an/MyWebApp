@using System.Globalization
@namespace webapp.Features.Vessels

<section class="vessel-section vessel-section--@Category" aria-labelledby="@HeadingId">
    <div class="vessel-section-heading">
        <h2 id="@HeadingId">@Title</h2>
        @if (ShowInfo && IsUnloading && TotalTonnes is { } totalTonnes)
        {
            <span class="badge rounded-pill vessel-total" title="Totalt losset.">
                @FormatTonnes(totalTonnes) totalt vekt losset
            </span>
        }
    </div>
    @if (Vessels.Count == 0)
    {
        <p class="vessel-empty">@EmptyMessage</p>
    }
    else
    {
        <ul class="vessel-list" tabindex="0" aria-labelledby="@HeadingId">
            @foreach (var vessel in SortedVessels)
            {
                var key = $"{Category}-{vessel.Id}";
                var expanded = openVessels.Contains(vessel.Id);
                var pinkGlow = vessel.Id == PinkGlowVesselId;
                <li class="vessel-item @(pinkGlow ? "vessel-item--pink" : null) @(expanded ? "is-expanded" : null)" @key="vessel.Id">
                    <button class="vessel-toggle" type="button"
                            aria-expanded="@(expanded ? "true" : "false")"
                            aria-controls="@($"history-{key}")" @onclick="() => Toggle(vessel.Id)">
                        <span class="vessel-identity">
                            <span class="vessel-title">
                                <span class="vessel-name">@vessel.Name</span>
                                @if (pinkGlow && expanded)
                                {
                                    <span class="vessel-heart" aria-hidden="true">♥</span>
                                }
                            </span>
                            @if (ShowInfo)
                            {
                                <span class="vessel-info">
                                    <span>@vessel.Entries.Count @(IsUnloading ? (vessel.Entries.Count == 1 ? "lossing" : "lossinger") : "oppdrag")</span>
                                    @if (IsUnloading)
                                    {
                                        <span> · @(vessel.TotalTonnes is { } total ? $"{FormatTonnes(total)} total vekt" : "vekt ikke registrert")</span>
                                        @if (vessel.HasExcludedWeights)
                                        {
                                            <span class="vessel-weight-caution">Ufullstendig vektgrunnlag</span>
                                        }
                                    }
                                </span>
                            }
                        </span>
                        <span class="vessel-chevron" aria-hidden="true">@(expanded ? "−" : "+")</span>
                    </button>
                    <div class="vessel-history" id="@($"history-{key}")" hidden="@(!expanded)">
                        @if (!string.IsNullOrWhiteSpace(vessel.Note))
                        {
                            <p class="vessel-note">@vessel.Note</p>
                        }
                        <table>
                            <caption>@(IsUnloading ? "Lossehistorikk" : "Utført arbeid") · @vessel.Name</caption>
                            <thead>
                                <tr>
                                    <th scope="col"></th>
                                    <th scope="col" class="@(IsUnloading ? "vessel-tonnes" : "")">@(IsUnloading ? "" : "Arbeidsbeskrivelse")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in vessel.Entries.OrderByDescending(entry => entry.Periods.Max(period => period.Start)))
                                {
                                    <tr @key="entry.Id">
                                        <td>
                                            @foreach (var period in entry.Periods.OrderByDescending(period => period.Start))
                                            {
                                                <span class="vessel-period">@period.Display</span>
                                            }
                                        </td>
                                        @if (IsUnloading)
                                        {
                                            <td class="vessel-tonnes">
                                                <span>@(entry.Tonnes is { } tonnes ? FormatTonnes(tonnes) : "Ikke registrert")</span>
                                                <span class="vessel-weight-note">@WeightLabel(entry)</span>
                                                @foreach (var url in entry.SourceUrls.Where(IsLandingUrl))
                                                {
                                                    <a class="vessel-source" href="@url" target="_blank" rel="noopener noreferrer">Fangstdata</a>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td>@entry.Description</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </li>
            }
        </ul>
        @if (IsUnloading)
        {
            <p class="vessel-footnote">All vekt opgitt i tonn.</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string EmptyMessage { get; set; } = "Ingen oppdrag er registrert ennå.";
    [Parameter, EditorRequired] public IReadOnlyList<Vessel> Vessels { get; set; } = [];
    [Parameter] public bool ShowInfo { get; set; }
    [Parameter] public bool SortDescending { get; set; }

    private readonly HashSet<string> openVessels = [];
    // Presentation-only accent; the history and imported data stay independent.
    private const string PinkGlowVesselId = "fangstdata-2013062792";
    private static readonly CultureInfo Norwegian = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly StringComparer NameComparer = StringComparer.Create(Norwegian, true);
    private bool IsUnloading => Category == "unloading";
    private string HeadingId => $"vessels-{Category}-title";
    private decimal? TotalTonnes => Vessels.Any(vessel => vessel.TotalTonnes.HasValue)
        ? Vessels.Sum(vessel => vessel.TotalTonnes ?? 0)
        : null;
    private IEnumerable<Vessel> SortedVessels => SortDescending
        ? Vessels.OrderByDescending(vessel => vessel.Name, NameComparer)
        : Vessels.OrderBy(vessel => vessel.Name, NameComparer);

    private void Toggle(string id)
    {
        if (!openVessels.Add(id)) openVessels.Remove(id);
    }

    private static string FormatTonnes(decimal tonnes) => tonnes.ToString("N2", Norwegian);
    private static string WeightLabel(VesselEntry entry) => entry.TonnageKind switch
    {
        "estimated" => "Estimat",
        "landing" => "Produktvekt",
        "timesheet" => "Fra timeseddel",
        "reported" => "Oppgitt vekt",
        _ => "",
    };

    private static bool IsLandingUrl(string url) => Uri.TryCreate(url, UriKind.Absolute, out var uri)
        && uri.Scheme == Uri.UriSchemeHttps && uri.Host == "fangstdata.no" && uri.AbsolutePath.StartsWith("/offload/", StringComparison.Ordinal);
}
