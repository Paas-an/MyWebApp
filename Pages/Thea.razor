@page "/thea"
@implements IDisposable

<PageTitle>Nedtelling</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<section class="thea-page text-center" aria-labelledby="thea-title">
    <div class="thea-message">
        <p class="hero-eyebrow">Til Thea</p>
        <h1 id="thea-title">Vb kjærester</h1>
        <div class="thea-gallery" aria-label="Bilder av Thea og Jonas">
            <figure>
                <img src="images/thea/strand.jpeg"
                     alt="Thea og Jonas på stranden"
                     width="876"
                     height="1560"
                     decoding="async" />
            </figure>
            <figure>
                <img src="images/thea/sammen.jpeg"
                     alt="Thea og Jonas sitter sammen"
                     width="960"
                     height="1276"
                     loading="lazy"
                     decoding="async" />
            </figure>
        </div>
        <span class="thea-heart" aria-hidden="true">♥</span>
    </div>

    <div class="countdown-container" aria-labelledby="countdown-title">
        <h2 class="countdown-title" id="countdown-title">Hun kommer hjem</h2>
        <p>@TargetDate.ToString("d. MMMM yyyy", NorwegianCulture)</p>

        <div class="time-grid">
            <div class="time-box">
                <span class="time-number">@GetDaysUntilJuly16()</span>
                <div class="time-label">Dager</div>
            </div>
            <div class="time-box">
                <span class="time-number">@GetHoursUntilJuly16()</span>
                <div class="time-label">Timer</div>
            </div>
            <div class="time-box">
                <span class="time-number">@Remaining.Minutes</span>
                <div class="time-label">Minutter</div>
            </div>
            <div class="time-box">
                <span class="time-number">@Remaining.Seconds</span>
                <div class="time-label">Sekunder</div>
            </div>
        </div>
        
        <div class="today-date">
            I dag: @GetTodaysDate()
        </div>
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo NorwegianCulture =
        new("nb-NO");

    private System.Threading.Timer? timer;
    private DateTime TargetDate { get; set; }
    private TimeSpan Remaining { get; set; }

    protected override void OnInitialized()
    {
        TargetDate = GetNextJuly16(DateTime.Now);
        UpdateRemaining();
        timer = new System.Threading.Timer(
            _ => InvokeAsync(() =>
            {
                UpdateRemaining();
                StateHasChanged();
            }),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private string GetTodaysDate()
    {
        return DateTime.Now.ToString("d. MMMM yyyy", NorwegianCulture);
    }

    private static DateTime GetNextJuly16(DateTime now)
    {
        var targetDate = new DateTime(now.Year, 7, 16);
        return targetDate > now ? targetDate : targetDate.AddYears(1);
    }

    private void UpdateRemaining()
    {
        Remaining = TargetDate - DateTime.Now;
        if (Remaining < TimeSpan.Zero)
        {
            TargetDate = GetNextJuly16(DateTime.Now);
            Remaining = TargetDate - DateTime.Now;
        }
    }

    private int GetDaysUntilJuly16()
    {
        return Math.Max(0, Remaining.Days);
    }

    private int GetHoursUntilJuly16()
    {
        return Math.Max(0, Remaining.Hours);
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
