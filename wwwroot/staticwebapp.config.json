{
  "routes": [
    { "route": "/contact", "rewrite": "/contact.html" },
    { "route": "/contact/", "rewrite": "/contact.html" },
    { "route": "/contact.html", "redirect": "/contact", "statusCode": 301 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/css/*",
      "/js/*",
      "/_framework/*",
      "/*.{ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,eot}"
    ]
  }
}
