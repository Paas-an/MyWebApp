@page "/contact"
@inject IJSRuntime JS

<PageTitle>Kontakt | Jonas Skogtrø Olsen</PageTitle>

<section class="contact-page" aria-labelledby="contact-title">
    <div class="contact-intro">
        <p class="hero-eyebrow">Kontakt</p>
        <h1 id="contact-title">La oss snakke sammen</h1>
        <p>
            Du finner meg på GitHub og LinkedIn, eller kan kopiere
            e-postadressen min direkte.
        </p>
    </div>

    <div class="contact-grid">
        <a class="contact-card"
           href="https://github.com/Paas-an"
           target="_blank"
           rel="noopener noreferrer">
            <span class="contact-card-label">GitHub</span>
            <strong>Se prosjektene mine</strong>
            <span>github.com/Paas-an</span>
        </a>

        <a class="contact-card"
           href="https://www.linkedin.com/in/jonas-skogtr%C3%B8-olsen-6a2397167/"
           target="_blank"
           rel="noopener noreferrer">
            <span class="contact-card-label">LinkedIn</span>
            <strong>Se erfaring og nettverk</strong>
            <span>Jonas Skogtrø Olsen</span>
        </a>

        <a class="contact-card"
           href="https://drive.google.com/file/d/1HqqwA0tYgKgEucA-czPKoEd4eTtTI9SR/view?usp=sharing"
           target="_blank"
           rel="noopener noreferrer">
            <span class="contact-card-label">CV</span>
            <strong>Åpne CV</strong>
            <span>Åpnes i en ny fane</span>
        </a>

        <div class="contact-card">
            <span class="contact-card-label">E-post</span>
            <strong>jolsenskogtro@gmail.com</strong>
            <button class="btn btn-outline-primary mt-3"
                    type="button"
                    @onclick="CopyEmailAsync">
                Kopier e-postadresse
            </button>
        </div>
    </div>

    <p class="clipboard-status @(copyFailed ? "text-danger" : "text-success")"
       role="status"
       aria-live="polite">
        @copyStatus
    </p>
</section>

@code {
    private const string Email = "jolsenskogtro@gmail.com";
    private string copyStatus = string.Empty;
    private bool copyFailed;

    private async Task CopyEmailAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Email);
            copyFailed = false;
            copyStatus = "E-postadressen er kopiert.";
        }
        catch
        {
            copyFailed = true;
            copyStatus = $"Kunne ikke kopiere automatisk. E-postadressen er {Email}.";
        }
    }
}
